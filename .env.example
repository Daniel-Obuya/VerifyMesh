# ==============================================================================
# VerifyMesh - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure values for your local environment:
#   cp .env.example .env
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Application Security
# Generate a cryptographically secure random 32-byte key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key

# Flask Environment & Debug
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
HOST=127.0.0.1

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_mysql_password
DB_NAME=verifymesh_db

# Cross-Origin Resource Sharing (CORS) - Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Google OAuth 2.0 Client ID (Optional for local development / testing)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email / SMTP Verification Service (Optional for local development / testing)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_SENDER_NAME=VerifyMesh
MAIL_SENDER_EMAIL=your-service-email@example.com
MAIL_SENDER_PASSWORD=your-app-specific-password

# Assessment Integrity & Policy Controls
ASSESSMENT_COOLDOWN_SECONDS=300
ASSESSMENT_ATTEMPT_DURATION_MINUTES=30
MAX_ASSESSMENT_ATTEMPTS=10
