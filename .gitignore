# ==============================================================================
# VerifyMesh - Git Ignore Rules
# ==============================================================================

# Python Virtual Environments
.venv/
venv/
env/
ENV/
*.venv/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Node.js / Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables & Secrets
.env
.env.*
.env.local
!.env.example

# IDE, OS & Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Jupyter Notebook Checkpoints & Cache
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Local Backups & Archive Files
*.zip
*.tar.gz
*.bak

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/

# Scratch & Temporary Developer Scripts
scratch/

# Machine Learning Large/Temporary Artifacts
# Note: The authoritative binary Random Forest model (backend/models/binary_eligibility_model.pkl, 3.45MB)
# is intentionally tracked for complete out-of-the-box reproducibility.
*.joblib
backend/models/*.joblib
