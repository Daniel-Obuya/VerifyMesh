# ==============================================================================
# VerifyMesh — Production Git Ignore Rules
# ==============================================================================

# --- Python Virtual Environments ---
.venv/
venv/
env/
ENV/
*.venv/

# --- Python Bytecode & Runtime Caches ---
__pycache__/
*.py[cod]
*$py.class
*.pyd

# --- Node.js & Frontend Build Outputs ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Environment Variables & Secrets (NON-NEGOTIABLE) ---
.env
.env.*
.env.local
!.env.example

# --- IDE, OS & System Metadata ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Jupyter Notebook Checkpoints ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Archives & Temporary Backups ---
*.zip
*.tar.gz
*.bak
*.orig

# --- Test, Coverage & Linter Caches ---
.coverage
htmlcov/
.pytest_cache/
.oxlint-cache/

# --- Ephemeral Developer Diagnostics & Scratch Scripts ---
scratch/

# --- Machine Learning Models & Large Artifacts ---
*.joblib
*.pkl
backend/models/*.pkl
backend/models/*.joblib

# Whitelist the authoritative, lightweight Stage 2 suitability model (2.6 KB):
!ml/models/verifymesh_stage2_suitability_pipeline_v2.joblib
